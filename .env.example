# ============================================================
# Buildee server — local .env example
# 복사: cp .env.example apps/server/.env  →  값 채우기
# ============================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ----- Database -----
DATABASE_URL_APP_MAIN="postgresql://buildee_admin:PASSWORD@buildee-pg-dev.postgres.database.azure.com:5432/app_main?sslmode=require"
PG_HOST=buildee-pg-dev.postgres.database.azure.com
PG_PORT=5432
PG_ADMIN_USER=buildee_admin
PG_ADMIN_PASSWORD=
PG_SSL=true

# Prisma client 빌드 placeholder (실제 값 안 씀)
DATABASE_URL_PROJ_TEMPLATE="postgresql://placeholder@localhost:5432/placeholder"

# ----- JWT (32자 이상) -----
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ----- CORS -----
CORS_ORIGINS=http://localhost:5173

# ----- GitHub App (Issue #3) -----
# docs/github-app-setup.md 참고
GITHUB_APP_ID=
# .pem 파일 내용 (개행은 \n으로). 또는 Key Vault에서 'github-app-private-key' 키로 자동 로드.
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_ORG=buildee-projects

# ----- Provider API keys (Tier 2 폴백) -----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ----- Azure -----
AZURE_BLOB_CONNECTION_STRING=
AZURE_KEY_VAULT_URL=

# ----- Monitoring -----
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ----- Email (Closed Beta) -----
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=noreply@buildee.app
